# Скопируйте в .env и настройте. Не добавляйте .env с секретами в Git.
# Конфигурация пайплайна Meevo (исследовательские скрипты / воспроизведение).

# Аудио
SAMPLE_RATE=16000
CHUNK_SEC=60                 # чанки ASR (GigaAM, лимит модели ~200 с)

# Модели (пути относительно корня репозитория; веса восстановить по MANIFEST.md)
ASR_MODEL=artifacts/models/gigaam_v3
DIAR_SEGMENTATION=artifacts/models/diar/model.fixed.onnx
DIAR_EMBEDDING=artifacts/models/diar/3dspeaker_speech_campplus_sv_zh-cn_16k-common.onnx
DIAR_THRESHOLD=0.7
PUNCT_MODEL=artifacts/models/punct_ru
LLM_MODEL=artifacts/models/llm/QVikhr-3-1.7B-Instruction-noreasoning-int4

# LLM
LLM_MAX_NEW_TOKENS=256
LLM_SYSTEM_PROMPT=config/prompts/system_prompt_ru.txt

# Eval
TEST_MANIFEST=artifacts/data/test/manifest.jsonl
